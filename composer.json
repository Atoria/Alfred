{
    "name": "atoria/alfred",
    "description": "Point at anything in your Laravel app and ask how it is calculated, change it with AI, or report it. Plain-language explanations, AI-proposed UI changes with live preview, tickets (Jira, GitHub, GitLab, Linear, Trello, ClickUp, Asana) and pull requests (GitHub, GitLab, Bitbucket).",
    "keywords": [
        "laravel",
        "filament",
        "livewire",
        "inertia",
        "openai",
        "ai",
        "ai-agent",
        "explainability",
        "dashboard",
        "jira",
        "github",
        "gitlab",
        "pull-request",
        "tickets",
        "developer-tools"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/Atoria/Alfred",
    "support": {
        "issues": "https://github.com/Atoria/Alfred/issues",
        "source": "https://github.com/Atoria/Alfred",
        "security": "https://github.com/Atoria/Alfred/security/policy",
        "docs": "https://github.com/Atoria/Alfred/tree/main/docs"
    },
    "authors": [
        {
            "name": "Andria Toria",
            "email": "toria.andria@gmail.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.17",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "livewire/livewire": "Component-level hints for Livewire and Filament pages",
        "stancl/tenancy": "Multi-tenancy: detected automatically (v3)",
        "spatie/laravel-multitenancy": "Multi-tenancy: detected automatically (v3, v4)",
        "maestroerror/laragent": "Run Alfred on Claude, Gemini, Groq, Ollama, OpenRouter or any OpenAI-compatible API (ALFRED_PROVIDER=laragent, PHP 8.3+)"
    },
    "autoload": {
        "psr-4": {
            "Atoria\\Alfred\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoria\\Alfred\\Tests\\Fixtures\\App\\": "tests/Fixtures/app/app/",
            "Atoria\\Alfred\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atoria\\Alfred\\AlfredServiceProvider"
            ],
            "aliases": {
                "Alfred": "Atoria\\Alfred\\Facades\\Alfred"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:test": "pint --test"
    },
    "config": {
        "sort-packages": true
    }
}
